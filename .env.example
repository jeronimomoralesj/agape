# ──────────────────────────────────────────────────────────────
# Ágape — Environment Variables
# Copy this file to .env.local for local development.
# Add the same variables in Vercel → Project → Settings → Environment Variables.
# ──────────────────────────────────────────────────────────────

# MongoDB Atlas connection string (Database → Connect → Drivers)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/agape?retryWrites=true&w=majority"

# Password for the /admin dashboard
ADMIN_PASSWORD="choose-a-strong-password"

# Random secret used to sign the admin session cookie (any long random string)
ADMIN_SESSION_SECRET="generate-a-long-random-string"

# ───────────────────────── SEO ─────────────────────────

# Canonical site URL (no trailing slash). REQUIRED for sitemap, feeds & JSON-LD.
NEXT_PUBLIC_SITE_URL="https://www.agape.com.co"

# IndexNow key for instant Bing/DuckDuckGo/Yahoo indexing.
# Generate one: openssl rand -hex 16  (served automatically at /indexnow.txt)
INDEXNOW_KEY=""

# Optional: site-verification tokens (paste only the token value, not the meta tag)
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
